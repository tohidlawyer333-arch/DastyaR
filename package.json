{
  "name": "dastyar-legal-desk",
  "version": "0.1.0",
  "productName": "DastyaR",
  "description": "دستیار دفتر وکالت فارسی با موتور عامل‌محور Goose",
  "main": "main.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check src/renderer.js",
    "dist": "electron-builder --win nsis zip --publish never",
    "dist:dir": "electron-builder --win dir"
  },
  "dependencies": {
    "7zip-bin": "5.2.0"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ir.dastyar.legaldesk",
    "productName": "DastyaR",
    "asar": true,
    "asarUnpack": ["node_modules/7zip-bin/**/*"],
    "files": ["main.js", "preload.js", "src/**/*", "package.json"],
    "extraResources": [
      { "from": "resources/goose", "to": "goose", "filter": ["**/*"] }
    ],
    "directories": { "output": "dist" },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "zip", "arch": ["x64"] }
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DastyaR",
      "deleteAppDataOnUninstall": false
    }
  }
}
